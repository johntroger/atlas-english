{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-english.local/schemas/content-pack.schema.json",
  "title": "IELTS Game Content Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "packVersion", "schemaVersion", "minimumAppVersion", "curriculumVersion", "language", "skill", "levelRange", "contentHash", "releasedAt", "reviewStatus", "provenanceRef", "exercises"],
  "properties": {
    "packId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "const": 2 },
    "minimumAppVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "curriculumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "const": "en" },
    "explanationLanguage": { "type": "string", "default": "vi" },
    "skill": { "enum": ["grammar", "vocabulary", "spelling", "pronunciation", "transfer", "performance"] },
    "levelRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5 }
      }
    },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "reviewStatus": { "enum": ["draft", "codex_pre_reviewed", "reviewed", "approved", "deprecated", "retired"] },
    "provenanceRef": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "rollbackTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": { "enum": ["deactivate", "version"] },
        "packVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "mode": { "const": "version" } }, "required": ["mode"] }, "then": { "required": ["packVersion"] } }
      ]
    },
    "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "exercise.schema.json" } }
  }
}
