{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-english.local/schemas/progress-export.schema.json",
  "title": "IELTS Game Progress Export",
  "type": "object",
  "additionalProperties": false,
  "required": ["exportId", "exportVersion", "exportedAt", "appVersion", "databaseSchemaVersion", "profile", "attempts", "mastery", "reviews", "externalAssessments", "checksum"],
  "properties": {
    "exportId": { "type": "string", "format": "uuid" },
    "exportVersion": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "appVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "databaseSchemaVersion": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "locale"],
      "properties": {
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "examType": { "const": "IELTS Academic" },
        "examDate": { "type": "string", "format": "date" }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attemptId", "exerciseId", "learningNodeId", "contentPackId", "contentPackVersion", "attemptedAt", "score"],
        "properties": {
          "attemptId": { "type": "string", "format": "uuid" },
          "exerciseId": { "type": "string" },
          "learningNodeId": { "type": "string" },
          "contentPackId": { "type": "string" },
          "contentPackVersion": { "type": "string" },
          "attemptedAt": { "type": "string", "format": "date-time" },
          "isCorrect": { "type": "boolean" },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "mistakeTags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "mastery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["learningNodeId", "score", "algorithmVersion"],
        "properties": {
          "learningNodeId": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "algorithmVersion": { "type": "string" }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["learningNodeId", "dueAt", "schedulerVersion"],
        "properties": {
          "learningNodeId": { "type": "string" },
          "dueAt": { "type": "string", "format": "date-time" },
          "schedulerVersion": { "type": "string" }
        }
      }
    },
    "externalAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assessmentId", "skill", "taskType", "sourceLabel", "startedAt", "timed", "confidence"],
        "properties": {
          "assessmentId": { "type": "string", "format": "uuid" },
          "supersedesId": { "type": "string", "format": "uuid" },
          "skill": { "enum": ["listening", "reading", "writing", "speaking"] },
          "taskType": { "type": "string", "minLength": 1 },
          "sourceLabel": { "type": "string", "minLength": 1 },
          "startedAt": { "type": "string", "format": "date-time" },
          "timed": { "type": "boolean" },
          "durationSeconds": { "type": "integer", "minimum": 0 },
          "rawScore": { "type": "number", "minimum": 0 },
          "band": { "type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5 },
          "dimensionScores": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 9 }
          },
          "reviewer": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "learningNodeIds": { "type": "array", "items": { "type": "string" } },
          "mistakeTags": { "type": "array", "items": { "type": "string" } },
          "nextAction": { "type": "string" }
        }
      }
    }
  }
}
