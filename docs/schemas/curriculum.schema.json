{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-english.local/schemas/curriculum.schema.json",
  "title": "IELTS Game Curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["curriculumId", "version", "target", "nodes"],
  "properties": {
    "curriculumId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exam", "currentEstimate", "goal"],
      "properties": {
        "exam": { "const": "IELTS Academic" },
        "currentEstimate": { "type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5 },
        "goal": { "type": "number", "minimum": 0, "maximum": 9, "multipleOf": 0.5 }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "learning-node.schema.json" }
    }
  }
}

